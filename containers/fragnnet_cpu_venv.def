Bootstrap: docker
From: ubuntu:22.04

%arguments

%post
    APT_INSTALL="apt-get install -y --no-install-recommends"
    PIP_INSTALL="python -m pip --no-cache-dir install --upgrade"

    # install python 3.10 and all dependencies
    apt-get update &&
    DEBIAN_FRONTEND=noninteractive $APT_INSTALL \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
        python3.10-venv \
        g++ \
        gcc \
        build-essential \
        libxrender1 \
        libxtst6 \
        libxi6 \
        curl \
        ca-certificates

    ln -s /usr/bin/python3.10 /usr/local/bin/python
    curl -sS https://bootstrap.pypa.io/get-pip.py | python
    # Create virtual environment directory and make it writable
    VENV_DIR=/opt/fragnnet_env
    mkdir -p $VENV_DIR
    chmod -R 777 $VENV_DIR
    python3 -m venv $VENV_DIR

    # Activate virtual environment
    . $VENV_DIR/bin/activate

    # Upgrade pip and install necessary packages
    pip install --upgrade pip
    $PIP_INSTALL setuptools 
    $PIP_INSTALL torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu 
    $PIP_INSTALL numpy==1.26.4
    $PIP_INSTALL rdkit-pypi==2022.9.4
    $PIP_INSTALL torch_geometric==2.4.0 pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv -f https://data.pyg.org/whl/torch-2.1.0%2Bcpu.html
    $PIP_INSTALL dgl==2.0.0 -f https://data.dgl.ai/wheels/repo.html
    $PIP_INSTALL \
        cython  \
        cysignals \
        pandas \
        networkx \
        wandb \
        tqdm \
        scipy \
        joblib \
        matplotlib \
        pytest \
        CairoSVG \
        lightning==2.1.2 \
        omegaconf \
        adjustText \
        scikit-learn \
        Pyarrow \
        pyteomics
        
    chmod -R 777 $VENV_DIR
%environment
    # Activate virtual environment upon container execution
    export VENV_DIR=/opt/fragnnet_env
    . $VENV_DIR/bin/activate
    export PATH=$VENV_DIR/bin:$PATH

%runscript
    # Default command to run when the container is executed
    echo "Running inside Apptainer with virtual environment"
    exec "$@"

%labels
    Author "fw"
    Version "1.0"