Bootstrap: docker
From: ubuntu:22.04

%arguments

%post
    APT_INSTALL="apt-get install -y --no-install-recommends"
    PIP_INSTALL="python -m pip --no-cache-dir install --upgrade"

    # install python 3.10 and all dependencies
    apt-get update &&
    DEBIAN_FRONTEND=noninteractive $APT_INSTALL \
        python3.10 \
        python3.10-dev \
        python3.10-distutils \
        g++ \
        gcc \
        build-essential \
        libxrender1 \
        libxtst6 \
        libxi6 \
        curl \
        ca-certificates
    ln -s /usr/bin/python3.10 /usr/local/bin/python
    curl -sS https://bootstrap.pypa.io/get-pip.py | python

    # install python packages
    $PIP_INSTALL setuptools \
        torch==2.1.0 --index-url https://download.pytorch.org/whl/cpu \
        numpy==1.26.4 \
        rdkit==2023.9.3 \
        lightning==2.1.2 \
        torch_geometric==2.4.0 pyg_lib torch_scatter torch_sparse torch_cluster torch_spline_conv -f https://data.pyg.org/whl/torch-2.1.0%2Bcpu.html \
        dgl==2.0.0 -f https://data.dgl.ai/wheels/repo.html \
        cython  \
        cysignals \
        pandas \
        networkx \
        wandb \
        tqdm \
        scipy \
        joblib \
        matplotlib \
        pytest \
        CairoSVG \
        omegaconf \
        adjustText \
        scikit-learn \
        pyteomics \
        hdf5

    apt-get clean && \
    apt-get autoremove
    #rm -rf /var/lib/apt/lists/* /tmp/* ~/*

%environment
    # Prevent Python from using user site-packages from /home/<user>/.local
    export PYTHONNOUSERSITE=1
    
%runscript
    # Default command to run when the container is executed
    echo "Running inside Apptainer with virtual environment"
    exec "$@"

%labels
    Author "fw"
    Version "1.0"